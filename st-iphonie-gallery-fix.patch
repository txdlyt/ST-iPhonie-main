diff --git a/tests/photo-wall.test.js b/tests/photo-wall.test.js
new file mode 100644
index 0000000..30f134d
--- /dev/null
+++ b/tests/photo-wall.test.js
@@ -0,0 +1,66 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {photoWall} from '../ui/photo-wall.js';
+
+function makeRoot(elements = []) {
+  return {
+    clientHeight: 320,
+    querySelectorAll: () => elements,
+    getBoundingClientRect: () => ({top: 0, bottom: 320, height: 320}),
+  };
+}
+
+function makeWindow(withObserver = true) {
+  const observers = [];
+  class FakeIntersectionObserver {
+    constructor(callback) { this.callback = callback; this.observed = []; observers.push(this); }
+    disconnect() {}
+    observe(element) { this.observed.push(element); }
+  }
+  const win = {URL: {createObjectURL: () => 'blob:test', revokeObjectURL() {}}};
+  if (withObserver) win.IntersectionObserver = FakeIntersectionObserver;
+  return {win, observers};
+}
+
+test('mount skips a photo stretch missing from the rendered DOM with IntersectionObserver', () => {
+  const {win, observers} = makeWindow(true);
+  const wall = photoWall({api: {}, win, tile: () => ''});
+  wall.html([{rows: [{id: 'missing-photo'}]}]);
+
+  assert.doesNotThrow(() => wall.mount(makeRoot()));
+  assert.deepEqual(observers[0].observed, []);
+  assert.equal(wall.reveal('missing-photo'), null);
+});
+
+test('mount skips a photo stretch missing from the rendered DOM without IntersectionObserver', () => {
+  const {win} = makeWindow(false);
+  const wall = photoWall({api: {}, win, tile: () => ''});
+  wall.html([{rows: [{id: 'missing-photo'}]}]);
+
+  assert.doesNotThrow(() => wall.mount(makeRoot()));
+  assert.equal(wall.reveal('missing-photo'), null);
+});
+
+test('a later mounted stretch is observed by its element, not by its old array index', () => {
+  const {win, observers} = makeWindow(true);
+  const el = {
+    dataset: {piece: '1'},
+    children: [],
+    innerHTML: '',
+    getBoundingClientRect: () => ({top: 0, bottom: 120}),
+  };
+  const root = makeRoot([el]);
+  const rows = Array.from({length: 25}, (_, i) => ({id: `photo-${i}`}));
+  const wall = photoWall({
+    api: {photoThumbs: async () => [], photoThumb: async () => null, getPhoto: async () => null},
+    win,
+    tile: row => `<button data-id="${row.id}"></button>`,
+  });
+  wall.html([{rows}]);
+
+  assert.doesNotThrow(() => wall.mount(root));
+  assert.deepEqual(observers[0].observed, [el]);
+  assert.match(el.innerHTML, /photo-24/);
+  assert.doesNotThrow(() => observers[0].callback([{target: el, isIntersecting: false}]));
+  assert.equal(el.textContent, '');
+});
